# Copy to .env.local for local development.
# On Vercel these go in Project → Settings → Environment Variables (Production).

# --- Site ---
# Absolute origin. Used for canonical URLs, social cards and the sitemap.
NEXT_PUBLIC_SITE_URL=https://orvexiqlabs.com

# --- Contact form (Hostinger mailbox) ---
# hPanel → Emails → your mailbox → Configuration settings
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# The full mailbox address, not just the part before the @. This is also the
# From: address on enquiry emails.
SMTP_USER=info@orvexiqlabs.com
# The mailbox password, not the hPanel account password.
SMTP_PASSWORD=
# Where enquiries land. The Starter Business Email plan allows one mailbox, so
# this is the same address that sends. Point it elsewhere if a second is added.
CONTACT_TO=info@orvexiqlabs.com
